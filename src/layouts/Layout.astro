---
import { topoPath } from '@/lib/topo';

// Generated once at build time; every contour layer on the page <use>s this symbol
const topo = topoPath();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<meta name="description" content="分享我的乐趣" />
		<meta name="keywords" content="全栈开发,Tauri,设计" />
		<meta name="author" content="拜瑞 (Burial0268)" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="分享我的乐趣 - Baesory" />
		<meta
			property="og:description"
			content="专注于现代技术与动效设计的全栈开发工程师"
		/>

		<!-- Google Fonts: Space Grotesk -->
		<link rel="preconnect" href="https://fonts.googleapis.cn" />
		<link rel="preconnect" href="https://fonts.gstatic.cn" crossorigin />
		<!-- Font stylesheets load without blocking first paint (media=print swap); text uses display=swap -->
		<link
			href="https://fonts.googleapis.cn/css2?family=Bebas+Neue&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>

		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<!-- HarmonyOS Sans -->
		<link
			rel="stylesheet"
			href="https://s1.hdslb.com/bfs/static/jinkela/long/font/regular.css"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.cn/css2?family=Bebas+Neue&family=Space+Grotesk:wght@500;600;700&display=swap" />
			<link rel="stylesheet" href="https://s1.hdslb.com/bfs/static/jinkela/long/font/regular.css" />
		</noscript>
		<title>分享我的乐趣 - Baesory</title>
	</head>
	<body>
		<svg width="0" height="0" style="position:absolute" aria-hidden="true">
			<symbol id="topo">
				<path d={topo} fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" />
			</symbol>
		</svg>
		<div id="loader">
			<div class="ld-grid"></div>
			<svg class="ld-topo" viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><use href="#topo" /></svg>
			<div class="ld-accent"><div class="ld-accent-fill"></div></div>
			<div class="ld-log">
				<p style="--i:0">
					[ 0.000000] burial-os 1.0.0-release (gcc 14.2.0) #1 SMP
					PREEMPT x86_64
				</p>
				<p style="--i:1">
					[ 0.003814] BIOS-e820: [mem
					0x0000000000000000-0x000000007fffffff] usable
				</p>
				<p style="--i:2">
					[ 0.008217] ACPI: RSDP 0x00000000000F0490 000024 (v02
					BURIAL)
				</p>
				<p style="--i:3" data-smp>
					[ 0.014903] smpboot: Bringing up 12 CPUs / 24 threads
				</p>
				<p style="--i:4">
					[ 0.022518] Memory: 16384496K/33554432K available (16384K
					kernel code)
				</p>
				<p style="--i:5">
					[ 0.031264] pci 0000:01:00.0: [10de:2684] type 00 BAR 0 [mem
					0xfe000000-0xffffffff]
				</p>
				<p style="--i:6" data-drm>
					[ 0.039817] drm: framebuffer [0x0] initialized at 0xfe000000
				</p>
				<p style="--i:7">
					[ 0.048290] init[1]: reached target — <span class="ld-ok"
						>system ready</span>
				</p>
			</div>
			<div class="ld-lock">
				<div class="ld-wm"><svg class="ld-brand" viewBox="-4 0 220 50"></svg></div>
				<div class="ld-meta">
					<span class="ld-dots"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
					<span>FULL-STACK / MOTION / 3D</span>
					<span>2026</span>
				</div>
			</div>
			<div class="ld-bottom">
				<div class="ld-pipe"></div>
				<div class="ld-pct">0%</div>
				<div class="ld-status">
					Initializing<span class="ld-blink">_</span>
				</div>
			</div>
			<div class="ld-progress"></div>
		</div>
		<script is:inline>
			(function(){
				var hwConcurrency = window.navigator.hardwareConcurrency ?? 12
				var dm=document.querySelector('[data-drm]');
				var hw = document.querySelector('[data-smp]');
				if(dm)dm.textContent='[    0.039817] drm: framebuffer ['+screen.width+'x'+screen.height+'] initialized at 0xfe000000';
				if(hw)hw.textContent='[    0.014903] smpboot: Bringing up '+ hwConcurrency +' CPUs / ' + hwConcurrency + ' threads';
			
				// Wordmark: chamfered monoline caps on a 20×40 cell, 32 pitch (B stays distinct from 8)
				var G={
					B:'M0 0V40M0 0H14L20 6V14L14 20H0M14 20L20 26V34L14 40H0',
					A:'M0 40L10 0L20 40M5 26H15',
					E:'M20 0H0V40H20M0 20H16',
					S:'M20 0H5L0 5V15L5 20H15L20 25V35L15 40H0',
					O:'M5 0H15L20 5V35L15 40H5L0 35V5Z',
					R:'M0 40V0H14L20 6V14L14 20H0M10 20L20 40',
					Y:'M0 0L10 20L20 0M10 20V40'
				};
				var ns='http://www.w3.org/2000/svg', sv=document.querySelector('.ld-brand'), tx='BAESORY';
				for(var c=0; c<tx.length; c++){
					var pa=document.createElementNS(ns,'path');
					pa.setAttribute('d',G[tx[c]]);
					pa.setAttribute('transform','translate('+(c*32)+' 5)');
					sv.appendChild(pa);
				}
			
				// 进度条逻辑
				var dots=document.querySelectorAll('.ld-dots i');
				var s=Date.now(), d=1800,
					p=document.querySelector('.ld-pct'),
					a=document.querySelector('.ld-accent-fill'),
					bt=document.querySelector('.ld-bottom'),
					lg=document.querySelector('.ld-log');
				// percentage starts below the TTY log, then rides down the accent bar
				var y0=lg?lg.offsetTop+lg.offsetHeight+32:24;
				(function tick(){
					var t=Math.min((Date.now()-s)/d, 1),
						e=1-Math.pow(1-t, 3),
						v=Math.round(e*100);
					if(p)p.textContent=v+'%';
					if(a)a.style.height=(e*100)+'%';
					for(var k=0;k<dots.length;k++)dots[k].classList.toggle('on',e*dots.length>k);
					if(bt)bt.style.transform='translateY('+(y0+e*(window.innerHeight-y0-bt.offsetHeight-40))+'px)';
					if(t<1)requestAnimationFrame(tick);
					else{
						window.__loaderDone=true;
						var ok=document.querySelector('.ld-ok');
						if(ok)ok.style.opacity='1';
					}
				})();
			})();
			</script>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		overflow-x: clip;
		-webkit-touch-callout: none; /* 禁止在移动设备上长按文本时显示默认的选择菜单 */
		-webkit-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		user-select: none;
	}

	body {
		font-family:
			"Space Grotesk",
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			Roboto,
			"Helvetica Neue",
			Arial,
			sans-serif;
	}

	/* Loader */
	#loader {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: #0a0a0a;
		overflow: hidden;
	}

	/* Exit: a cyan panel sweeps across (Endfield's colour flash), then the loader fades under it */
	#loader::after {
		content: "";
		position: absolute;
		inset: 0;
		background: #6ce5e8;
		clip-path: inset(0 100% 0 0);
		z-index: 2;
	}

	#loader.loader-exit {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease 0.45s;
	}

	#loader.loader-exit::after {
		animation: ld-wipe 0.75s cubic-bezier(0.7, 0, 0.3, 1) forwards;
	}

	.ld-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
		background-size: 96px 96px;
		background-position: -1px -1px;
	}

	.ld-topo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		color: rgba(255, 255, 255, 0.11);
		opacity: 0;
		transform: scale(1.06);
		animation:
			hud-flash 0.9s linear 0.5s forwards,
			ld-settle 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
	}

	.ld-accent {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: rgba(255, 255, 255, 0.06);
	}

	.ld-accent-fill {
		width: 100%;
		height: 0%;
		background: #6ce5e8;
	}

	.ld-log {
		position: absolute;
		top: 24px;
		left: 20px;
		right: 20px;
		font-family: "Courier New", Consolas, monospace;
		font-size: 11px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.35);
	}

	.ld-log p {
		margin: 0;
		opacity: 0;
		white-space: nowrap;
		overflow: hidden;
		animation: ld-type 0.1s ease forwards;
		animation-delay: calc(var(--i) * 0.07s);
	}

	.ld-ok {
		color: #6ce5e8;
		opacity: 0;
		transition: opacity 0.1s ease;
	}

	.ld-lock {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: clamp(240px, 50vw, 460px);
	}

	/* Block reveal (same cyan panel as the exit wipe): the panel sweeps across and the mark appears behind it */
	.ld-wm {
		position: relative;
		overflow: hidden;
	}

	.ld-wm::after {
		content: "";
		position: absolute;
		inset: 0;
		background: #6ce5e8;
		clip-path: inset(0 100% 0 0);
		animation: ld-wipe 0.8s cubic-bezier(0.7, 0, 0.3, 1) 0.3s forwards;
	}

	.ld-brand {
		display: block;
		width: 100%;
		fill: none;
		stroke: #fff;
		stroke-width: 5;
		stroke-linejoin: miter;
		stroke-miterlimit: 2;
		opacity: 0;
		animation: ld-show 0.8s step-end 0.3s forwards;
	}

	.ld-meta {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 16px;
		padding-top: 10px;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		font-family: "Courier New", Consolas, monospace;
		font-size: 10px;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.5);
		opacity: 0;
		animation: ld-type 0.5s ease 1.1s forwards;
	}

	.ld-meta span:last-child {
		margin-left: auto;
	}

	/* Dot matrix fills with load progress */
	.ld-dots {
		display: flex;
		gap: 3px;
	}

	.ld-dots i {
		width: 5px;
		height: 5px;
		background: rgba(255, 255, 255, 0.18);
	}

	.ld-dots i.on {
		background: #6ce5e8;
	}

	.ld-bottom {
		position: absolute;
		top: 0;
		left: 20px;
		will-change: transform;
	}

	.ld-pipe {
		width: 2px;
		height: 14px;
		background: #6ce5e8;
		margin-bottom: 6px;
	}

	.ld-pct {
		font-family: "Space Grotesk", sans-serif;
		font-size: clamp(36px, 8vw, 56px);
		font-weight: 700;
		color: #6ce5e8;
		line-height: 1;
	}

	.ld-status {
		font-family: "Courier New", Consolas, monospace;
		font-size: 11px;
		color: rgba(255, 255, 255, 0.3);
		margin-top: 6px;
		letter-spacing: 0.05em;
	}

	.ld-blink {
		animation: ld-cursor 0.6s step-end infinite;
	}

	.ld-progress {
		position: absolute;
		bottom: 0;
		left: 3px;
		right: 0;
		height: 1px;
		background: rgba(255, 255, 255, 0.06);
	}

	@keyframes ld-type {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ld-show {
		55%,
		100% {
			opacity: 1;
		}
	}

	@keyframes ld-settle {
		to {
			transform: scale(1);
		}
	}

	@keyframes ld-wipe {
		0% {
			clip-path: inset(0 100% 0 0);
		}
		55% {
			clip-path: inset(0 0 0 0);
		}
		100% {
			clip-path: inset(0 0 0 100%);
		}
	}

	@keyframes ld-cursor {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}
</style>
