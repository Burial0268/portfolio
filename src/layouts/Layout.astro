---
import { topoPath } from '@/lib/topo';

// Generated once at build time; every contour layer on the page <use>s this symbol
const topo = topoPath();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<meta name="description" content="分享我的乐趣" />
		<meta name="keywords" content="全栈开发,Tauri,设计" />
		<meta name="author" content="拜瑞 (Burial0268)" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="分享我的乐趣 - Baesory" />
		<meta
			property="og:description"
			content="专注于现代技术与动效设计的全栈开发工程师"
		/>

		<!-- Google Fonts: Inter Tight (Swiss grotesk) -->
		<link rel="preconnect" href="https://fonts.googleapis.cn" />
		<link rel="preconnect" href="https://fonts.gstatic.cn" crossorigin />
		<link
			href="https://fonts.googleapis.cn/css2?family=Inter+Tight:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>

		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<!-- HarmonyOS Sans -->
		<link
			rel="stylesheet"
			href="https://s1.hdslb.com/bfs/static/jinkela/long/font/regular.css"
		/>
		<title>分享我的乐趣 - Baesory</title>
	</head>
	<body>
		<svg width="0" height="0" style="position:absolute" aria-hidden="true">
			<symbol id="topo">
				<path d={topo} fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" />
			</symbol>
		</svg>
		<div id="loader">
			<div class="ld-grid"></div>
			<svg class="ld-topo" viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><use href="#topo" /></svg>
			<div class="ld-accent"><div class="ld-accent-fill"></div></div>
			<div class="ld-log">
				<p style="--i:0">
					[ 0.000000] burial-os 1.0.0-release (gcc 14.2.0) #1 SMP
					PREEMPT x86_64
				</p>
				<p style="--i:1">
					[ 0.003814] BIOS-e820: [mem
					0x0000000000000000-0x000000007fffffff] usable
				</p>
				<p style="--i:2">
					[ 0.008217] ACPI: RSDP 0x00000000000F0490 000024 (v02
					BURIAL)
				</p>
				<p style="--i:3" data-smp>
					[ 0.014903] smpboot: Bringing up 12 CPUs / 24 threads
				</p>
				<p style="--i:4">
					[ 0.022518] Memory: 16384496K/33554432K available (16384K
					kernel code)
				</p>
				<p style="--i:5">
					[ 0.031264] pci 0000:01:00.0: [10de:2684] type 00 BAR 0 [mem
					0xfe000000-0xffffffff]
				</p>
				<p style="--i:6" data-drm>
					[ 0.039817] drm: framebuffer [0x0] initialized at 0xfe000000
				</p>
				<p style="--i:7">
					[ 0.048290] init[1]: reached target — <span class="ld-ok"
						>system ready</span>
				</p>
			</div>
			<svg class="ld-brand" viewBox="0 0 212 50"></svg>
			<div class="ld-bottom">
				<div class="ld-pipe"></div>
				<div class="ld-pct">0%</div>
				<div class="ld-status">
					Initializing<span class="ld-blink">_</span>
				</div>
			</div>
			<div class="ld-progress"></div>
		</div>
		<script is:inline>
			(function(){
				var hwConcurrency = window.navigator.hardwareConcurrency ?? 12
				var dm=document.querySelector('[data-drm]');
				var hw = document.querySelector('[data-smp]');
				if(dm)dm.textContent='[    0.039817] drm: framebuffer ['+screen.width+'x'+screen.height+'] initialized at 0xfe000000';
				if(hw)hw.textContent='[    0.014903] smpboot: Bringing up '+ hwConcurrency +' CPUs / ' + hwConcurrency + ' threads';
			
				var G={
					B:[[0,0,0,40],[0,0,20,0],[20,0,20,20],[0,20,20,20],[20,20,20,40],[0,40,20,40]],
					A:[[0,40,10,0],[10,0,20,40],[5,24,15,24]],
					E:[[0,0,0,40],[0,0,20,0],[0,20,16,20],[0,40,20,40]],
					S:[[0,0,20,0],[0,0,0,20],[0,20,20,20],[20,20,20,40],[0,40,20,40]],
					O:[[0,0,20,0],[0,0,0,40],[20,0,20,40],[0,40,20,40]],
					R:[[0,0,0,40],[0,0,20,0],[20,0,20,20],[0,20,20,20],[10,20,20,40]],
					Y:[[0,0,10,20],[20,0,10,20],[10,20,10,40]]
				};
				var ns='http://www.w3.org/2000/svg', sv=document.querySelector('.ld-brand'),
					tx='BAESORY', xO=0;
				var centerX = (tx.length * 32) / 2; 
				var centerY = 25;
				for(var c=0; c<tx.length; c++){
					var sg=G[tx[c]];
					for(var j=0; j<sg.length; j++){
						var ln=document.createElementNS(ns,'line');
						var x1 = xO+sg[j][0];
						var y1 = 5+sg[j][1];
						var x2 = xO+sg[j][2];
						var y2 = 5+sg[j][3];
						ln.setAttribute('x1', x1);
						ln.setAttribute('y1', y1);
						ln.setAttribute('x2', x2);
						ln.setAttribute('y2', y2);
						var isH = Math.abs(y1 - y2) < 0.1; // 是否是横线
						var isV = Math.abs(x1 - x2) < 0.1; // 是否是竖线
						
						// 计算当前线条的几何中心
						var midX = (x1 + x2) / 2;
						var midY = (y1 + y2) / 2;
			
						var dx = 0, dy = 0;
						// 偏移量：设置大一点，确保从屏幕外飞入
						var dist = 300; 
			
						if(isH) {
							// 如果是横线：
							// 在中心左边 -> 从左侧(-dist)飞入
							// 在中心右边 -> 从右侧(+dist)飞入
							dx = (midX < centerX ? -1 : 1) * dist;
							dy = 0; // 锁定 Y 轴，只平移
						} else if (isV) {
							// 如果是竖线：
							// 在中心上边 -> 从上方(-dist)飞入
							// 在中心下边 -> 从下方(+dist)飞入
							dx = 0; // 锁定 X 轴
							dy = (midY < centerY ? -1 : 1) * dist;
						} else {
							// 斜线 (如 A, R, Y 的部分)：同时受 X 和 Y 影响
							dx = (midX < centerX ? -1 : 1) * dist;
							dy = (midY < centerY ? -1 : 1) * dist;
						}
			
						ln.style.setProperty('--dx', dx+'px');
						ln.style.setProperty('--dy', dy+'px');
			
						// 范围 0.1s ~ 0.5s 之间随机
						ln.style.setProperty('--d', (0.1 + Math.random() * 0.4) + 's');
						
						sv.appendChild(ln);
					}
					xO+=32;
				}
			
				// 进度条逻辑
				var s=Date.now(), d=1800,
					p=document.querySelector('.ld-pct'),
					a=document.querySelector('.ld-accent-fill'),
					bt=document.querySelector('.ld-bottom'),
					lg=document.querySelector('.ld-log');
				// percentage starts below the TTY log, then rides down the accent bar
				var y0=lg?lg.offsetTop+lg.offsetHeight+32:24;
				(function tick(){
					var t=Math.min((Date.now()-s)/d, 1),
						e=1-Math.pow(1-t, 3),
						v=Math.round(e*100);
					if(p)p.textContent=v+'%';
					if(a)a.style.height=(e*100)+'%';
					if(bt)bt.style.transform='translateY('+(y0+e*(window.innerHeight-y0-bt.offsetHeight-40))+'px)';
					if(t<1)requestAnimationFrame(tick);
					else{
						window.__loaderDone=true;
						var ok=document.querySelector('.ld-ok');
						if(ok)ok.style.opacity='1';
					}
				})();
			})();
			</script>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		-webkit-touch-callout: none; /* 禁止在移动设备上长按文本时显示默认的选择菜单 */
		-webkit-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		user-select: none;
	}

	body {
		font-family:
			"Inter Tight",
			"HarmonyOS_Regular",
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			Roboto,
			"Helvetica Neue",
			Arial,
			sans-serif;
	}

	/* Loader */
	#loader {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: #0a0a0a;
		overflow: hidden;
	}

	/* Exit: a cyan panel sweeps across (Endfield's colour flash), then the loader fades under it */
	#loader::after {
		content: "";
		position: absolute;
		inset: 0;
		background: #6ce5e8;
		clip-path: inset(0 100% 0 0);
		z-index: 2;
	}

	#loader.loader-exit {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease 0.45s;
	}

	#loader.loader-exit::after {
		animation: ld-wipe 0.75s cubic-bezier(0.7, 0, 0.3, 1) forwards;
	}

	.ld-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
		background-size: 96px 96px;
		background-position: -1px -1px;
	}

	.ld-topo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		color: rgba(255, 255, 255, 0.11);
		opacity: 0;
		transform: scale(1.06);
		animation:
			hud-flash 0.9s linear 0.5s forwards,
			ld-settle 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
	}

	.ld-accent {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: rgba(255, 255, 255, 0.06);
	}

	.ld-accent-fill {
		width: 100%;
		height: 0%;
		background: #6ce5e8;
	}

	.ld-log {
		position: absolute;
		top: 24px;
		left: 20px;
		right: 20px;
		font-family: "Courier New", Consolas, monospace;
		font-size: 11px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.35);
	}

	.ld-log p {
		margin: 0;
		opacity: 0;
		white-space: nowrap;
		overflow: hidden;
		animation: ld-type 0.1s ease forwards;
		animation-delay: calc(var(--i) * 0.07s);
	}

	.ld-ok {
		color: #6ce5e8;
		opacity: 0;
		transition: opacity 0.1s ease;
	}

	.ld-brand {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: clamp(240px, 50vw, 460px);
		overflow: visible;
	}

	.ld-brand line {
		stroke: rgba(255, 255, 255, 0.85);
		stroke-width: 2;
		stroke-linecap: square;
		opacity: 0;
		transform: translate(var(--dx), var(--dy));
		animation: ld-assemble 0.6s cubic-bezier(0.2, 1, 0.3, 1) forwards;
		animation-delay: var(--d);
	}

	.ld-bottom {
		position: absolute;
		top: 0;
		left: 20px;
		will-change: transform;
	}

	.ld-pipe {
		width: 2px;
		height: 14px;
		background: #6ce5e8;
		margin-bottom: 6px;
	}

	.ld-pct {
		font-family: "Inter Tight", sans-serif;
		font-size: clamp(36px, 8vw, 56px);
		font-weight: 800;
		letter-spacing: -0.04em;
		color: #6ce5e8;
		line-height: 1;
	}

	.ld-status {
		font-family: "Courier New", Consolas, monospace;
		font-size: 11px;
		color: rgba(255, 255, 255, 0.3);
		margin-top: 6px;
		letter-spacing: 0.05em;
	}

	.ld-blink {
		animation: ld-cursor 0.6s step-end infinite;
	}

	.ld-progress {
		position: absolute;
		bottom: 0;
		left: 3px;
		right: 0;
		height: 1px;
		background: rgba(255, 255, 255, 0.06);
	}

	@keyframes ld-type {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes ld-assemble {
		to {
			opacity: 1;
			transform: translate(0, 0);
		}
	}

	@keyframes ld-settle {
		to {
			transform: scale(1);
		}
	}

	@keyframes ld-wipe {
		0% {
			clip-path: inset(0 100% 0 0);
		}
		55% {
			clip-path: inset(0 0 0 0);
		}
		100% {
			clip-path: inset(0 0 0 100%);
		}
	}

	@keyframes ld-cursor {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}
</style>
